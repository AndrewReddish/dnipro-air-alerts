[Unit]
Description=Dnipro air alert monitor (Telegram -> Bark)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/dnipro-air-alerts
EnvironmentFile=/home/ubuntu/dnipro-air-alerts/.env
ExecStart=/home/ubuntu/dnipro-air-alerts/.venv/bin/python monitor.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
